{
  "name": "plainvoice-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker backend for the Plainvoice Pro paywall: Stripe Checkout, webhook-issued license keys, license verify.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "resend": "^4.0.1",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "2.1.9",
    "wrangler": "^3.95.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  }
}
